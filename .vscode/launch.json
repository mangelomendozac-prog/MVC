{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "EntradasMvc (HTTPS)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Compilar EntradasMvc",
      "program": "${workspaceFolder}/bin/Debug/net10.0/EntradasMvc.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole",
      "launchSettingsProfile": "https",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https://\\S+)"
      }
    }
  ]
}
